# ===== T-Pass SSO =====
# Auth 服務的 JWKS 公鑰端點
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
# JWT 簽發者（必須與 Token 的 iss 完全一致）
JWT_ISSUER=https://auth.lvh.me:3000/
# 本服務在 T-Pass 註冊的服務 ID
TPASS_SERVICE_ID=classsuperman
# Auth 授權端點
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
# Auth 登出端點
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout
# 本服務對外 URL
SERVICE_SELF_URL=http://localhost:3000
# 權限被拒絕時的導向 URL
AUTH_DENIED_URL=https://auth.lvh.me:3000/auth/denied

# ===== 課表系統 =====
# 各年級定時抓取的來源 API（Model/api.py 的 input_schedule_api），以年級區分
# 高一（s1.json）
SCHEDULE_API_URL_S1=
# 高二（s2.json）；未設定時退回 SCHEDULE_API_URL
SCHEDULE_API_URL_S2=
# 高三（s3.json）
SCHEDULE_API_URL_S3=
# 必修課程，以 , 區隔
# 全體共同必修
REQUIRED_COURSES=開學日,自我覺察(二)
# 各年級專屬必修（可選，與共同必修合併）
REQUIRED_COURSES_S1=
REQUIRED_COURSES_S2=
REQUIRED_COURSES_S3=

# ===== 排程（pm2）=====
# 用 pm2 start ecosystem.config.js 啟動；每次啟動/重啟都會立即抓取一次最新課表

# ===== 僅供本機開發測試 =====
# 設定後（且 NODE_ENV 非 production）略過 T-Pass 驗證，直接以該 email 登入
# DEV_BYPASS_EMAIL=11430111@tschool.tp.edu.tw
