# 真值放 .env.local（不進 git）。本檔只列 key + 說明；本機預設值可直接照抄。

# ── SSO（契約 v2，見 tpass-auth/INTEGRATION.md）───────────────────────
TPASS_SERVICE_ID=schedule
JWT_ISSUER=https://auth.lvh.me:3000
AUTH_JWKS_URL=https://auth.lvh.me:3000/.well-known/jwks.json
AUTH_AUTHORIZE_URL=https://auth.lvh.me:3000/api/auth/authorize
AUTH_LOGOUT_URL=https://auth.lvh.me:3000/api/auth/logout
SCHEDULE_SELF_URL=https://schedule.lvh.me:3010
PORTAL_URL=https://portal.lvh.me:3001
# 權限被拒絕時的導向 URL（選填，預設 auth 的 /denied）
AUTH_DENIED_URL=https://auth.lvh.me:3000/denied

# ── 資料庫（本機慣例：postgresql://t_schedule@localhost:5432/t_schedule）──
DATABASE_URL=postgresql://t_schedule@localhost:5432/t_schedule

# ── 課表來源 ───────────────────────────────────────────────────────
# 各年級定時抓取的來源 API（Model/api.py 的 input_schedule_api），以年級區分
SCHEDULE_API_URL_S1=
# 高二；未設定時退回 SCHEDULE_API_URL（向後相容舊值）
SCHEDULE_API_URL_S2=
SCHEDULE_API_URL_S3=
# 必修課程，以 , 區隔
REQUIRED_COURSES=開學日,自我覺察(二)
# 各年級專屬必修（可選，與共同必修合併）
REQUIRED_COURSES_S1=
REQUIRED_COURSES_S2=
REQUIRED_COURSES_S3=

# ── Google Calendar 雙向同步 ─────────────────────────────────────────
# 這組 OAuth client 只用來取得 Calendar 寫入授權，不是登入——登入一律走 T-Pass。
# 必須建在學校 Workspace 的 GCP 專案下、同意畫面設 Internal（見 AGENTS.md 的例外條款）。
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# refresh token 落地前的 AES-256-GCM 加密金鑰，32 bytes base64（openssl rand -base64 32）
CALENDAR_TOKEN_KEY=
# 只接受這個網域的 Google 帳號做同步（防止有人把課表灌進學校網域外的帳號）
SCHOOL_EMAIL_DOMAIN=tschool.tp.edu.tw
# 同步 worker 的限速（每分鐘幾個 request，Google 專案預設上限 600/min）
CALENDAR_SYNC_RATE_PER_MIN=300
